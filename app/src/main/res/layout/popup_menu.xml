<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView android:id="@+id/pm_sync" style="@style/App.PopupItem" android:text="Sambungkan Kas Kelas" />
        <View style="@style/App.PopupDivider" />
        <TextView android:id="@+id/pm_test" style="@style/App.PopupItem" android:text="Tes notifikasi" />
        <View style="@style/App.PopupDivider" />
        <TextView android:id="@+id/pm_notif" style="@style/App.PopupItem" android:text="Pengaturan notifikasi" />
        <View style="@style/App.PopupDivider" />
        <TextView android:id="@+id/pm_about" style="@style/App.PopupItem" android:text="Tentang" />
    </LinearLayout>
</FrameLayout>
