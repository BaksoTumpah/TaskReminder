<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="8dp"
    android:paddingEnd="22dp"
    android:paddingBottom="4dp">

    <Spinner android:id="@+id/spDay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" android:entries="@array/hari" />
    <EditText android:id="@+id/etSubject" style="@style/App.Input"
        android:hint="Mata pelajaran" android:inputType="textCapWords" />
    <EditText android:id="@+id/etRoom" style="@style/App.Input"
        android:hint="Ruang / guru (opsional)" android:inputType="textCapWords" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnStart" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginEnd="4dp" android:text="07:00" app:cornerRadius="16dp" />
        <Button android:id="@+id/btnEnd" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:text="08:30" app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
