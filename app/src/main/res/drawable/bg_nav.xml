<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient android:angle="315" android:endColor="#40FFFFFF" android:startColor="#CCFFFFFF" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient android:angle="315" android:endColor="#CCF6F2FF" android:startColor="#EFFFFFFF" />
        </shape>
    </item>
</layer-list>
