<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetBottom="6dp" android:insetLeft="8dp" android:insetRight="8dp" android:insetTop="6dp">
            <shape android:shape="rectangle">
                <corners android:radius="28dp" />
                <gradient android:angle="315" android:endColor="#1AFFFFFF" android:startColor="#47FFFFFF" />
                <stroke android:width="1dp" android:color="#40FFFFFF" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /></shape>
    </item>
</selector>
