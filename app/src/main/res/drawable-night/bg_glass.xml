<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="315" android:endColor="#0FFFFFFF" android:startColor="#47FFFFFF" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="315" android:endColor="#E61D2142" android:startColor="#F22B3157" />
        </shape>
    </item>
</layer-list>
